# Copy to .env.local and fill in. Never commit a filled copy.
#
# Only the variables under "Site" and "Email" are validated by src/lib/env.ts
# today. Everything below them belongs to a later phase and is listed here so
# the shape is known in advance — env.ts does not read them, so setting or
# omitting them changes nothing yet. (This header previously claimed every
# variable in the file was validated at boot, which was not true and made the
# unused ones look like build requirements.)
#
# Exactly ONE variable is required: NEXT_PUBLIC_SITE_URL — and even that is
# resolved automatically on Vercel and on a local build. See "Site" below.

# ── Site ───────────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Drives canonicals, OG tags and sitemap.
#
# Resolution order, in src/lib/env.ts:
#   1. this variable, if set — always wins
#   2. https://$VERCEL_PROJECT_PRODUCTION_URL  (VERCEL_ENV=production)
#   3. https://$VERCEL_URL                     (any other Vercel deployment)
#   4. http://localhost:3000                   (no VERCEL_ENV — local or CI)
# If none of those yield a value, the build fails by design.
#
# Set it explicitly for production anyway: it is the only spelling that pins the
# canonical domain, and step 2 follows whatever domain Vercel considers primary.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Without these the contact form still validates and responds, but delivery is
# skipped — see src/lib/mailer.ts.
RESEND_API_KEY=""
# Where enquiries land.
CONTACT_TO_EMAIL="advisory@ultronfinancial.com"
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL="website@ultronfinancial.com"

# ── Database (Phase 3 — not required to run the site) ──────────────────────
# Pooled connection for the app.
DATABASE_URL=""
# Direct connection for `prisma migrate`. Bypasses the pooler.
DIRECT_URL=""

# ── Rate limiting (Phase 2 — required before production) ───────────────────
# Until these are set, src/lib/rate-limit.ts uses a per-instance in-memory
# store, which does NOT hold across serverless invocations.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Auth (Phase 4 — admin panel) ───────────────────────────────────────────
AUTH_SECRET=""
AUTH_URL=""
