# Supabase Configuration
# Public Supabase URL & Anon Key (Safe for browser code)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-actual-anon-key

# Server-Only Secret Key (NEVER expose to browser bundles)
SUPABASE_SECRET_KEY=your-actual-secret-key-or-service-role-key

# Optional Resend / Transactional Email Settings
INQUIRY_NOTIFICATION_EMAIL=info@ultronfinancials.com
INQUIRY_FROM_EMAIL=Ultron Financials <notifications@verified-domain.com>
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_EMAIL=info@ultronfinancials.com
